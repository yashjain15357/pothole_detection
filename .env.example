# =============================================
# Fix My City - Pothole Detection App
# Environment Variables for Render Deployment
# =============================================
# Set these in Render → Service → Environment tab
# DO NOT commit actual secrets to git

# --- Flask Security ---
SECRET_KEY=change-this-to-a-long-random-string-in-production

# --- Google OAuth (get from Google Cloud Console) ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- SMTP Email (Gmail App Password) ---
SMTP_EMAIL=your-gmail@gmail.com
SMTP_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_STARTTLS=true

# --- Database (optional: set to a Railway persistent volume mount path) ---
# DATABASE_DIR=/data

# --- CORS (optional: comma-separated extra allowed origins) ---
# CORS_ORIGINS=https://your-custom-domain.com
